# ---------------------------------------------------------------------------
# friend-group-oauth — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Public base URL of THIS auth server (no trailing slash).
# Used to build Discord redirect URIs and signed pay receipts.
APP_URL=http://localhost:3000

# Postgres connection string (your VPS Postgres).
# Example: postgres://oauth:password@localhost:5432/friend_oauth
DATABASE_URL=postgres://oauth:password@localhost:5432/friend_oauth

# Secret for signing session cookies + pay receipts (HMAC/JWE).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Discord application (https://discord.com/developers/applications) ---
# OAuth2 client credentials for logging users in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token for the same application. The bot must be a member of your guild
# with permission to read members, so we can look up roles via the REST API.
DISCORD_BOT_TOKEN=

# The Discord server (guild) users must belong to.
DISCORD_GUILD_ID=

# Comma-separated role IDs. A user is "allowed" if they hold ANY of these roles.
# Leave empty to allow any guild member (membership-only gating).
DISCORD_REQUIRED_ROLE_IDS=

# Comma-separated Discord user IDs that bootstrap as admins on first login.
ADMIN_DISCORD_IDS=

# --- Crypto (USDT) top-ups ---------------------------------------------------
# Members buy credits by sending USDT to a personal deposit address derived for
# them. Fixed rate: 1 USDT = 1 USD = 32 TWD = 32 credits. Whatever USDT arrives
# is credited (floor of USDT x 32). Leave these blank to disable top-ups.

# Account-level extended PUBLIC key (xpub) of the wallet that receives USDT,
# at the BIP44 Ethereum account path m/44'/60'/0'. The server derives a unique
# address per member from this WATCH-ONLY — it never holds private keys and
# cannot move funds; sweep deposits yourself with the seed kept offline.
# Export it from your wallet (e.g. MetaMask/Ledger account extended public key).
# Same derived address receives on every supported EVM chain.
USDT_HD_XPUB=

# Shared secret protecting the poller endpoint (GET /api/topups/poll?secret=...).
# Point an external cron at that URL every minute or two. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TOPUP_POLL_SECRET=

# (Optional) Override the public JSON-RPC endpoint used to watch each chain for
# deposits, e.g. if a public node is flaky or rate-limits. The var name is
# EVM_RPC_<chainId>. Defaults are public nodes that need no key.
#   EVM_RPC_1=https://your-eth-rpc
#   EVM_RPC_56=https://your-bsc-rpc
#   EVM_RPC_137=...   EVM_RPC_42161=...   EVM_RPC_10=...
